# Copier en .env.local. Clé publiable (sans danger dans l'app). Jamais de clé secrète ici.
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# RevenueCat : clés publiques du SDK (tableau de bord RevenueCat > API keys). La clé secrète va dans les secrets Supabase.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=premium
# Liens obligatoires sur le paywall (Apple et Google).
EXPO_PUBLIC_URL_CGU=https://...
EXPO_PUBLIC_URL_CONFIDENTIALITE=https://...

# CAPTCHA Cloudflare Turnstile (création des comptes anonymes). Vide = pas de CAPTCHA.
# Clé de test officielle (passe toujours) : 1x00000000000000000000AA
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# Domaine déclaré dans le widget Turnstile (la WebView du téléphone se présente sous ce domaine).
EXPO_PUBLIC_TURNSTILE_DOMAINE=

# Affiliation Awin : ton identifiant d'éditeur (« awinaffid », public). Vide = liens d'article sans affiliation.
# Les marchands acceptés se déclarent dans la table Supabase `marchands_affilies` (domaine, nom, id_annonceur).
EXPO_PUBLIC_AWIN_ID_EDITEUR=
